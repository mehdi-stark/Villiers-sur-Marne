ADMIN_EMAILS=admin@delivup.io
# Resend — seul fournisseur d'e-mail. Absent = aucun OTP ne part, une alerte le dit.
RESEND_API_KEY=
EMAIL_FROM=Ville <onboarding@resend.dev>
