{
  "name": "ville-monorepo",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "dev": "pnpm --filter cockpit dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @ville/core db:generate",
    "db:migrate": "pnpm --filter @ville/core db:migrate",
    "db:check": "pnpm --filter @ville/core db:check",
    "decisions": "pnpm --filter cockpit decisions",
    "notifier": "pnpm --filter cockpit notifier",
    "capturer": "pnpm --filter cockpit capturer",
    "deployer": "bash scripts/deployer.sh"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "dotenv": "^17.4.2"
  }
}
