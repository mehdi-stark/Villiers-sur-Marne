# Copier en .env.local (jamais commité). Une base PAR projet (Neon « ville »).
DATABASE_URL=postgresql://…/neondb?sslmode=require
# Secret de session PROPRE à ce projet (openssl rand -base64 48)
AUTH_SECRET=
# Adresses autorisées à se connecter au cockpit (séparées par des virgules)
ADMIN_EMAILS=mehdi.stark@gmail.com
# Resend — seul fournisseur d'e-mail. Absent = aucun OTP ne part, une alerte le dit.
RESEND_API_KEY=
EMAIL_FROM=Ville <onboarding@resend.dev>
# Push : l'agent notifie l'opérateur via POST /api/agent (scripts/notifier.mjs)
AGENT_SECRET=
COCKPIT_URL=http://localhost:3000
PUSH_CONTACT=mailto:mehdi.stark@gmail.com
# Lanceur (facultatif) : « Prévenir l'agent maintenant » dépose une consigne à la session ouverte
LANCEUR_URL=
LANCEUR_SECRET=
LANCEUR_DOSSIER=ville
